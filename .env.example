# 复制为 .env 后填写。两种方式任选一种：
# 1) 直接填 Cookie 字符串（BDUSS=xxx; STOKEN=yyy）或 tieba_cookies.json 的完整内容
TIEBA_COOKIES=
# 2) 或者把 tieba_cookies.json 放到 ./secrets/ 下，再取消下面这行的注释
# TIEBA_COOKIES_FILE=/app/secrets/tieba_cookies.json

# 可选：Server酱 SendKey，用于微信推送
SENDKEY=

# 每天几点执行（北京时间 HH:MM）
RUN_AT=02:30
# 容器启动后是否立刻跑一次（首次部署验证时设为 1）
RUN_ON_START=0
